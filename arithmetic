<%@page contentType="text/html" pageEncoding="UTF-8"%>

<!DOCTYPE html>
<html>
<head>
    <title>Arithmetic Calculation Using JSP</title>
</head>

<body>

    <h1>ARITHMETIC CALCULATION USING JSP</h1>

    <h2>Addition</h2>
    <% out.print(2 + 5); %>

    <h2>Subtraction</h2>
    <% out.print(8 - 5); %>

    <h2>Multiplication</h2>
    <% out.print(9 * 9); %>

    <h2>Division</h2>
    <% out.print(25 / 5); %>

    <h2>Remainder</h2>
    <% out.print(25 % 5); %>

</body>
</html>
